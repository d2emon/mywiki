 <item
  id="131"
  ean=""
  name="Zuma"
  boxpic=""
  backpic=""
  platform=""
  players="Offline: 1"
  editor="PopCap Games, Inc."
  developer="PopCap Games, Inc."
  released="2003"
  web="http://www.mobygames.com/game/windows/zuma-deluxe##MobyGames"
  rating="0"
