 <item
  id="242"
  ean=""
  name="Flashback"
  boxpic=""
  backpic=""
  platform=""
  players="Offline: 1"
  editor="Strategic Simulations, Inc."
  developer="Delphine Software International"
  released="1993"
  web="http://www.mobygames.com/game/dos/flashback-the-quest-for-identity##MobyGames"
  rating="0"
