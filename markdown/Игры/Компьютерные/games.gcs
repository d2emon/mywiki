 <item
  id="75"
  ean=""
  name="James Pond 2"
  boxpic=""
  backpic=""
  platform=""
  players="Offline: 1"
  editor="Millennium Interactive Ltd."
  developer="Vectordean Ltd."
  released="1993"
  web="http://www.mobygames.com/game/dos/james-pond-2-codename-robocod##MobyGames"
  rating="0"
  ratingpress="7"
