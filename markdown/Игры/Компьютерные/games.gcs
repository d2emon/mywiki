 <item
  id="236"
  ean=""
  name="Relentless"
  boxpic=""
  backpic=""
  platform=""
  players="Offline: 1"
  editor="Electronic Arts, Inc."
  developer="Adeline Software International"
  released="1995"
  web="http://www.mobygames.com/game/dos/relentless-twinsens-adventure##MobyGames"
  rating="0"
