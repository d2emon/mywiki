 <item
  id="203"
  ean=""
  name="The Incredible Machine 2"
  boxpic=""
  backpic=""
  platform=""
  players="Offline: 1-2 Players"
  editor="Sierra On-Line, Inc."
  developer="Jeff Tunnell Productions"
  released="1994"
  web="http://www.mobygames.com/game/dos/incredible-machine-2##MobyGames"
  rating="0"
  ratingpress="8"
  case="1"
  manual="1"
  exclusive="0"
  added="15/06/2015"
  completion="0"
  resolutions=""
  location=""
