 <item
  id="88"
  ean=""
  name="Prince of Persia"
  boxpic=""
  backpic=""
  platform=""
  players="Offline: 1"
  editor="Brøderbund Software, Inc."
  developer="Brøderbund Software, Inc."
  released="1990"
  web="http://www.mobygames.com/game/dos/prince-of-persia##MobyGames"
  rating="0"
  ratingpress="8"
