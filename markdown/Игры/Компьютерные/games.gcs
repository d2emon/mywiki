  developer="Sierra On-Line, Inc."
  released="1992"
  web="http://www.mobygames.com/game/dos/dagger-of-amon-ra##MobyGames"
  rating="0"
  ratingpress="7"
  case="1"
  manual="1"
  exclusive="0"
  added="26/07/2015"
