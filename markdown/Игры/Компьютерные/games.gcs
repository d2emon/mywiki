 <item
  id="202"
  ean=""
  name="The Incredible Machine"
  boxpic=""
  backpic=""
  platform=""
  players="1"
  editor="Sierra On-Line, Inc."
  developer="Dynamix, Inc."
  released="1993"
  web="http://www.mobygames.com/game/dos/incredible-machine##MobyGames"
  rating="0"
  ratingpress="8"
  case="1"
  manual="1"
  exclusive="0"
