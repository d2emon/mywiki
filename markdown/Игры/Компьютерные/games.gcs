  <code>
   <line>
    <col>&lt;ul&gt;Mines&lt;li&gt;STRT&lt;li&gt;FBWC&lt;li&gt;QP7R&lt;li&gt;WJTV&lt;/ul&gt;&lt;ul&gt;Forest&lt;li&gt;RRYB&lt;li&gt;ZS9P&lt;li&gt;XJSN&lt;li&gt;CGDM&lt;/ul&gt;&lt;ul&gt;Canyons&lt;li&gt;TJ1F&lt;li&gt;GSG3&lt;li&gt;BMHS&lt;li&gt;Y4DJ&lt;/ul&gt;&lt;ul&gt;Castle&lt;li&gt;HCKD&lt;li&gt;NRLF&lt;li&gt;J6BZ&lt;li&gt;MJXG&lt;/ul&gt;&lt;ul&gt;Sarlac&lt;li&gt;K3CH&lt;/ul&gt;</col>
    <col>Level codes</col>
   </line>
  </code>
 </item>
