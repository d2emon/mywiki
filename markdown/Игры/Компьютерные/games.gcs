  </genre>
 </item>
 <item
  id="139"
  ean=""
  name="Wild Snakes"
  boxpic=""
  backpic=""
  platform=""
  players="1-2 Players"
  editor="Spectrum Holobyte, Inc."
  developer="J.S.C. Gamos"
  released="1994"
  web="http://www.mobygames.com/game/snes/wildsnake##MobyGames"
  rating="0"
  ratingpress="8"
  case="1"
  manual="1"
  exclusive="0"
