 <item
  id="47"
  ean=""
  name="Arnie Savage 2"
  boxpic=""
  backpic=""
  platform=""
  players="1"
  editor="Celery Software"
  developer="Zeppelin Games Limited"
  released="1994"
  web="http://www.mobygames.com/game/dos/arnie-savage-combat-commando##MobyGames"
