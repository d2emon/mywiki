 <item
  id="230"
  ean=""
  name="Quake"
  boxpic=""
  backpic=""
  platform="DOS"
  players="Online: 16 Players"
  editor="id Software, Inc."
  developer="id Software, Inc."
  released="Jun 22, 1996"
  web="http://www.mobygames.com/game/dos/quake##MobyGames"
  rating="0"
  ratingpress="9"
  case="1"
  manual="1"
  exclusive="0"
  added="08/07/2015"
  completion="0"
  resolutions=""
  location=""
